<Window x:Class="Shimeji_Adjuster.Paths"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shimeji_Adjuster"
        mc:Ignorable="d"
        Title="Paths" Height="350" Width="375">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Actions File:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Bottom"/>
        <Label Content="Behavior File:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Bottom" Grid.Row="2"/>
        <Label Content="Settings File:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Bottom" Grid.Row="4"/>
        <Label Content="Image File:" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Bottom" Grid.Row="6"/>

        <TextBox x:Name="txt_actions" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Height="18" Margin="20,0,0,0" MinWidth="300" />
        <TextBox x:Name="txt_behaviors" Grid.Row="3" VerticalAlignment="Top" HorizontalAlignment="Left" Height="18" Margin="20,0,0,0" MinWidth="300" />
        <TextBox x:Name="txt_settings" Grid.Row="5" VerticalAlignment="Top" HorizontalAlignment="Left" Height="18" Margin="20,0,0,0" MinWidth="300" />
        <TextBox x:Name="txt_icon" Grid.Row="7" VerticalAlignment="Top" HorizontalAlignment="Left" Height="18" Margin="20,0,0,0" MinWidth="300" />

        <Button x:Name="btn_actionsSelect" Grid.Column="2" Content="..." HorizontalAlignment="Right" Grid.Row="1" VerticalAlignment="Top" Padding="10,1,10,1" Margin="10,0,20,0"/>
        <Button x:Name="btn_behaviorsSelect" Grid.Column="2" Content="..." HorizontalAlignment="Right" Grid.Row="3" VerticalAlignment="Top" Padding="10,1,10,1" Margin="10,0,20,0"/>
        <Button x:Name="btn_settingsSelect" Grid.Column="2" Content="..." HorizontalAlignment="Right" Grid.Row="5" VerticalAlignment="Top" Padding="10,1,10,1" Margin="10,0,20,0"/>
        <Button x:Name="btn_iconSelect" Grid.Column="2" Content="..." HorizontalAlignment="Right" Grid.Row="7" VerticalAlignment="Top" Padding="10,1,10,1" Margin="10,0,20,0"/>
        <Button x:Name="btn_save" Content="Save" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="8" VerticalAlignment="Top" Width="75" Height="20" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
